{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ryladmin:capabilities:v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ryladmin.capabilities.v1"
    },
    "project_ref": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "status": {
            "type": "string",
            "enum": [
              "ADMITTED",
              "SUSPENDED",
              "EXPERIMENTAL",
              "NOT_ADMITTED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        },
        "required": [
          "name",
          "status",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "live_dispatch": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schema",
    "project_ref",
    "capabilities",
    "live_dispatch"
  ],
  "additionalProperties": false
}
